# Copy this file to .env and fill in real values. Never commit .env itself
# (it is already excluded in .gitignore) - only this .example file is tracked.

# --- Database ---------------------------------------------------------------
# PostgreSQL 16. For local development, run one in Docker:
#   docker run -d --name agrilease-postgres -p 127.0.0.1:5434:5432 #     -e POSTGRES_USER=agrilease -e POSTGRES_PASSWORD=change-me -e POSTGRES_DB=agrilease #     -v agrilease-postgres-data:/var/lib/postgresql/data postgres:16
#   docker exec agrilease-postgres createdb -U agrilease agrilease_test

DATABASE_URL="postgresql://agrilease:change-me@localhost:5434/agrilease?schema=public"

# Used only by `npm test`, which wipes and re-migrates it on every run. Must be
# a different database from DATABASE_URL (the test config refuses otherwise).
TEST_DATABASE_URL="postgresql://agrilease:change-me@localhost:5434/agrilease_test?schema=public"

# --- Auth --------------------------------------------------------------------

# HMAC signing secret for session JWTs. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in any NODE_ENV other than "development" - the app refuses to start
# without it (see src/lib/auth/jwt.ts). Never reuse a secret across environments.
JWT_SECRET="replace-with-a-generated-random-secret"

# --- Gemini (optional) -------------------------------------------------------
# Powers the AI assistant and the plain-language summaries on the yield and
# recommendation pages. Create a key at https://aistudio.google.com/apikey.
# Server only: never rename it with a NEXT_PUBLIC_ prefix. Without a key the
# assistant uses its built-in template answers and no summaries are shown.
GEMINI_API_KEY=""
# Model to call. Default: gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- External data APIs (Phase 2) --------------------------------------------
# Open-Meteo, NASA POWER, and SoilGrids are free, public, and require no API
# key for non-commercial use - nothing to configure here. This section is a
# placeholder in case a rate-limited or authenticated tier is adopted later.
# OPEN_METEO_API_KEY=
# NASA_POWER_API_KEY=
# SOILGRIDS_API_KEY=

# --- Maps ---------------------------------------------------------------------
# None of these are required: every default is a free, keyless service. For
# production traffic, point them at your own or a paid instance (see docs/maps.md).
#
# Basemap style (MapLibre style JSON). Default: OpenFreeMap "Positron".
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
#
# OpenStreetMap Overpass endpoint(s) for water resources and supply shops,
# comma-separated, tried in order. The public instances are often at capacity
# and their policy asks automated users to self-host.
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
#
# Place search (Nominatim). The public instance allows 1 request/second.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
#
# User-Agent sent to OpenStreetMap services (they require an identifying one;
# include a contact URL or email for production).
# GEO_USER_AGENT="agriLease/1.0 (+https://your-domain.example/contact)"
